{
  "name": "arcus-development-website",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "npm run build:client && next dev",
    "build": "npm run build:client && next build",
    "start": "next start",
    "build:client": "esbuild client/blob-upload.ts --bundle --minify --format=esm --target=es2020 --outfile=public/blob-upload.js",
    "lint": "eslint .",
    "content": "uv run --with pillow python3 scripts/author-site.py && python3 scripts/build-pages.py",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@vercel/blob": "2.8.2",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.37.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.5",
    "typescript": "5.9.3"
  },
  "type": "module"
}
