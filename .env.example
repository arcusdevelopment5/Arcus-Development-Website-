# Copy to .env.local for local development. On Vercel, set these in Project → Settings → Environment Variables.

# Resend (https://resend.com). Without these, local dev only logs the e-mail to the console.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Arcus Development <forma@arcusdevelopment.gr>"
# Who receives the enquiries (comma-separated).
CONTACT_TO_EMAIL=info@arcusdevelopment.gr
# "on" also sends a short confirmation to the customer.
CONTACT_CONFIRMATION=off

# Vercel Blob (private store) for attachments. Added automatically when the store is connected to the project.
BLOB_READ_WRITE_TOKEN=

# Cloudflare Turnstile (optional, recommended in production). Leave empty to use the honeypot only.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Launch switch: "on" removes noindex and opens robots.txt (production deploys only). Redeploy after changing.
SITE_INDEXING=off
SITE_URL=https://arcusdevelopment.gr
